MOCK_MODE=true
DATABASE_URL=sqlite:///./gateway.db
VALIO_BASE_URL=https://junction26.valioaimo.fi
VALIO_API_KEY=
VALIO_CUSTOMER_ID=junction-demo
# Optional buyer -> supplier customer binding (challenge backend permits any customer number).
# VALIO_CUSTOMER_IDS={"restaurant-a":"123","hotel-b":"456"}
VALIO_TIMEOUT_SECONDS=20
# LLM: GLM via OpenRouter (OpenAI-compatible). LLM_MODEL = the OpenRouter model id of the chosen GLM model.
OPENROUTER_API_KEY=
LLM_MODEL=z-ai/glm-5.3-flash
# Signs single-use demo approval links (any long random string; set as a Worker secret in production).
APPROVAL_SIGNING_KEY=
FRONTEND_ORIGINS=http://localhost:5173
# Set in Cloudflare Pages build environment; this is public, not a secret.
# Dev only (vite dev already defaults to http://localhost:8000). Never set for production builds.
# VITE_API_BASE_URL=http://localhost:8000
