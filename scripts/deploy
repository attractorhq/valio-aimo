#!/usr/bin/env bash
# ARCHITECT MACHINE ONLY: build the catalogue, build the UI, then deploy Worker + Container on one origin.
#   scripts/deploy                      full deploy (Worker + container image)
#   scripts/deploy --containers-rollout=none   Worker/UI only, keep the running container image
# Needs: data/raw (event data), Docker (builds and pushes the image), `wrangler login`, secrets set:
#   (cd edge && npx wrangler secret put VALIO_API_KEY)        # and OPENROUTER_API_KEY, APPROVAL_SIGNING_KEY
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "deploy: $*" >&2; exit 1; }

[ -s data/raw/products.json ] || fail "data/raw/products.json is missing; deploy runs on the architect machine only."
command -v docker >/dev/null || fail "Docker is required to build the container image."
docker info >/dev/null 2>&1 || fail "the Docker daemon is not running."

bash scripts/guard
scripts/build-catalog
[ -s data/catalog/catalog.json ] || fail "the catalogue artifact was not built (data/catalog/catalog.json)."

(cd frontend && npm ci && npm run build)
(cd edge && npm ci && npm run check)
if docker buildx version >/dev/null 2>&1; then
  (cd edge && npx wrangler deploy "$@")
else
  # No docker-buildx (wrangler builds with `docker build --load`): build with the legacy builder, push the
  # image to the Cloudflare registry and deploy a generated config that points at it (gitignored).
  tag="valio-aimo-gateway:$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo "-dirty$(date +%s)")"
  DOCKER_BUILDKIT=0 docker build -q -f backend/Dockerfile -t "$tag" .
  image=$(cd edge && npx wrangler containers push "$tag" | sed -n 's/^Pushed image: //p' | tail -1)
  [ -n "$image" ] || fail "pushing $tag to the Cloudflare registry failed."
  python3 - "$image" <<'EOF'
import json, re, sys
cfg = json.loads(re.sub(r"^\s*//.*$", "", open("edge/wrangler.jsonc").read(), flags=re.M))
cfg["containers"][0]["image"] = sys.argv[1]
cfg["containers"][0].pop("image_build_context", None)
open("edge/wrangler.registry.json", "w").write(json.dumps(cfg, indent=2))
EOF
  (cd edge && npx wrangler deploy --config wrangler.registry.json "$@")
fi

echo "deploy: ok. Smoke test: curl -fsS https://valio-aimo.<account>.workers.dev/health"
