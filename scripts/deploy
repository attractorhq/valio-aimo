#!/usr/bin/env bash
# ARCHITECT MACHINE ONLY: build the catalogue, build the UI, then deploy Worker + Container on one origin.
#   scripts/deploy                      full deploy (Worker + container image)
#   scripts/deploy --containers-rollout=none   Worker/UI only, keep the running container image
# A full deploy ends when /health reports the new build sha (T48). DEPLOY_URL overrides the URL that is read
# from the wrangler output.
# Needs: data/raw (event data), Docker (builds and pushes the image), `wrangler login`, secrets set:
#   (cd edge && npx wrangler secret put VALIO_API_KEY)        # and OPENROUTER_API_KEY, APPROVAL_SIGNING_KEY
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

fail() { echo "deploy: $*" >&2; exit 1; }

[ -s data/raw/products.json ] || fail "data/raw/products.json is missing; deploy runs on the architect machine only."
command -v docker >/dev/null || fail "Docker is required to build the container image."
docker info >/dev/null 2>&1 || fail "the Docker daemon is not running."

# The wrangler login can see several Cloudflare accounts; pin the team account from .env (not a secret).
if [ -z "${CLOUDFLARE_ACCOUNT_ID:-}" ] && [ -f .env ]; then
  CLOUDFLARE_ACCOUNT_ID="$(sed -n 's/^CLOUDFLARE_ACCOUNT_ID=//p' .env | tail -1 | tr -d '"'"'"' \r')"
  [ -n "$CLOUDFLARE_ACCOUNT_ID" ] && export CLOUDFLARE_ACCOUNT_ID
fi
[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ] || fail "set CLOUDFLARE_ACCOUNT_ID (in .env or the environment): wrangler sees more than one account."

bash scripts/guard
scripts/build-catalog
[ -s data/catalog/catalog.json ] || fail "the catalogue artifact was not built (data/catalog/catalog.json)."

# T48: the commit this deploy ships. /health reports it as "build" once the new container serves traffic.
# data/catalog/ is gitignored and copied into the image, so the sha also reaches images built by wrangler.
build_sha="$(git rev-parse --short HEAD)$(git diff --quiet HEAD || echo "-dirty$(date +%s)")"
printf '%s\n' "$build_sha" > data/catalog/BUILD_SHA
deploy_log="$(mktemp)"
trap 'rm -f "$deploy_log"' EXIT

# Production UI calls the gateway on its own origin: never bake a dev API base (e.g. localhost:8000 from .env)
# into the bundle, or browsers call the visitor's own machine (Chrome asks for local-network access).
(cd frontend && npm ci && VITE_API_BASE_URL= npm run build)
if grep -rq "localhost:8000" frontend/dist; then fail "frontend/dist references localhost:8000; check VITE_API_BASE_URL."; fi
(cd edge && npm ci && npm run check)
if docker buildx version >/dev/null 2>&1; then
  (cd edge && npx wrangler deploy "$@") 2>&1 | tee "$deploy_log"
else
  # No docker-buildx (wrangler builds with `docker build --load`): build with the legacy builder, push the
  # image to the Cloudflare registry and deploy a generated config that points at it (gitignored).
  tag="valio-aimo-gateway:$build_sha"
  DOCKER_BUILDKIT=0 docker build -q --build-arg "BUILD_SHA=$build_sha" -f backend/Dockerfile -t "$tag" .
  image=$(cd edge && npx wrangler containers push "$tag" | sed -n 's/^Pushed image: //p' | tail -1)
  [ -n "$image" ] || fail "pushing $tag to the Cloudflare registry failed."
  python3 - "$image" <<'EOF'
import json, re, sys
cfg = json.loads(re.sub(r"^\s*//.*$", "", open("edge/wrangler.jsonc").read(), flags=re.M))
cfg["containers"][0]["image"] = sys.argv[1]
cfg["containers"][0].pop("image_build_context", None)
open("edge/wrangler.registry.json", "w").write(json.dumps(cfg, indent=2))
EOF
  (cd edge && npx wrangler deploy --config wrangler.registry.json "$@") 2>&1 | tee "$deploy_log"
fi

# Wait for the container rollout (~2 min): the old instance keeps serving until then, and requests in flight
# during the switch can fail. Done when /health reports this deploy's build sha.
case " $* " in
  *" --containers-rollout=none "*)
    echo "deploy: ok (Worker/UI only; the running container keeps its build)."
    exit 0 ;;
esac
url="${DEPLOY_URL:-$(grep -Eo 'https://[A-Za-z0-9.-]+\.workers\.dev' "$deploy_log" | head -1)}"
[ -n "$url" ] || fail "deployed, but the URL is unknown; set DEPLOY_URL to wait for the rollout."
echo "deploy: waiting for $url/health to report build $build_sha (timeout 5 min) ..."
deadline=$(( $(date +%s) + 300 ))
while :; do
  live=$(curl -fsS --max-time 10 "$url/health" 2>/dev/null \
         | python3 -c 'import json,sys; print(json.load(sys.stdin).get("build",""))' 2>/dev/null || true)
  if [ "$live" = "$build_sha" ]; then
    echo "deploy: rollout complete. $url serves build $build_sha."
    break
  fi
  [ "$(date +%s)" -lt "$deadline" ] || fail "rollout not complete after 5 min: /health reports build '${live:-?}', expected $build_sha."
  sleep 10
done

# Warm the new container (mandates, catalogue search index, one agent run in a throwaway session) so the
# first visitor after a deploy does not wait for lazy initialisation. Uses no live Valio calls beyond one
# shortlist, and the throwaway session never touches anyone else's state.
warm_session="deploy-warmup-$build_sha"
curl -fsS --max-time 60 -o /dev/null -H "X-Demo-Sandbox: $warm_session" "$url/v0.1/mandates" || true
curl -fsS --max-time 60 -o /dev/null -H "X-Demo-Sandbox: $warm_session" -H 'Content-Type: application/json' \
  -d '{"query":"lactose-free milk","limit":5}' "$url/v0.1/products/search" || true
curl -fsS --max-time 90 -o /dev/null -H "X-Demo-Sandbox: $warm_session" -H 'Content-Type: application/json' \
  -H 'Accept: application/json' \
  -d '{"customerId":"nordic-harbour-hotels","requestText":"I need 1,000 litres of lactose-free milk by Monday"}' \
  "$url/v0.1/agent/run" || true
echo "deploy: warmed up."
