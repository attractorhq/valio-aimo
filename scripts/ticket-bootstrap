#!/usr/bin/env python3
"""Create GitHub labels and one issue per `### T..` section of docs/TICKETS.md.

  scripts/ticket-bootstrap            dry run: print what would be created
  scripts/ticket-bootstrap --apply    create labels + issues, then rewrite "Depends on: T.." to "#N"

Idempotent: tickets whose title already exists as an issue are skipped.
"""

import json
import re
import subprocess
import sys
from pathlib import Path

REPO = "attractorhq/valio-aimo"
ROOT = Path(__file__).resolve().parent.parent
LABELS = {
    "ticket": "0e8a16", "P0": "b60205", "P1": "fbca04", "P2": "c2e0c6", "unlocked": "006b75", "judge": "5319e7", "contract-change": "d93f0b",
    "status:ready": "0e8a16", "status:blocked": "cccccc", "status:in-progress": "1d76db", "status:review": "c5def5",
    **{f"lane:{lane}": "bfdadc" for lane in ("data", "core", "agent", "api", "web", "infra", "demo")},
}


def gh(*args: str, check: bool = True) -> str:
    return subprocess.run(["gh", *args], check=check, capture_output=True, text=True).stdout


def parse() -> list[dict]:
    text = (ROOT / "docs/TICKETS.md").read_text()
    tickets = []
    for chunk in re.split(r"^### ", text, flags=re.M)[1:]:
        head, *rest = chunk.split("\n")
        m = re.match(r"(T\d+): (.+)", head.strip())
        if not m:
            continue
        meta = re.match(r"Lane: (\w+) · Priority: (P\d) · Depends on: (.+)", rest[0].strip())
        touches = rest[1].strip()
        if not meta or not touches.startswith("Touches:"):
            sys.exit(f"bad metadata in {m.group(1)}")
        deps = re.findall(r"T\d+", meta.group(3))
        body = "\n".join(rest[2:]).strip()
        body = re.sub(r"^\*\*(Goal|Scope|Acceptance)\.\*\*", r"## \1\n", body, flags=re.M)
        tickets.append({"tid": m.group(1), "title": f"{m.group(1)}: {m.group(2)}", "lane": meta.group(1),
                        "prio": meta.group(2), "deps": deps, "touches": touches, "body": body})
    return tickets


def issue_body(t: dict, numbers: dict[str, int] | None) -> str:
    deps = ", ".join(f"#{numbers[d]}" if numbers and d in numbers else d for d in t["deps"]) or "–"
    return (f"**Ticket:** {t['tid']} · **Lane:** {t['lane']} · **Priority:** {t['prio']}\n"
            f"Depends on: {deps}\n{t['touches']}\n\n{t['body']}\n\n"
            f"_References: § = `data/raw/BRIEF.txt`, P = `data/raw/BRIEF_PATCH_v2.txt` (both gitignored; ask the team). The patch wins on conflicts._")


def main() -> None:
    apply = "--apply" in sys.argv
    tickets = parse()
    existing = {i["title"]: i["number"] for i in json.loads(gh("issue", "list", "-R", REPO, "--state", "all",
                                                                "--limit", "300", "--json", "title,number"))}
    print(f"{len(tickets)} tickets in docs/TICKETS.md; {len(existing)} issues already in {REPO}")
    if not apply:
        for t in tickets:
            mark = "exists" if t["title"] in existing else "create"
            print(f"  [{mark}] {t['title']}  ({t['prio']}, lane:{t['lane']}, deps: {', '.join(t['deps']) or '–'})")
        print("dry run. Re-run with --apply to create labels and issues.")
        return

    have = {lbl["name"] for lbl in json.loads(gh("label", "list", "-R", REPO, "--limit", "200", "--json", "name"))}
    for name, color in LABELS.items():
        if name not in have:
            gh("label", "create", name, "-R", REPO, "--color", color)
    numbers = {t["tid"]: existing[t["title"]] for t in tickets if t["title"] in existing}
    for t in tickets:
        if t["tid"] in numbers:
            continue
        status = "status:ready" if not t["deps"] else "status:blocked"
        url = gh("issue", "create", "-R", REPO, "--title", t["title"], "--body", issue_body(t, numbers),
                 "--label", f"ticket,{t['prio']},lane:{t['lane']},{status}").strip()
        numbers[t["tid"]] = int(url.rsplit("/", 1)[1])
        print(f"  created #{numbers[t['tid']]} {t['title']}")
    for t in tickets:  # second pass: every dependency now has an issue number
        gh("issue", "edit", str(numbers[t["tid"]]), "-R", REPO, "--body", issue_body(t, numbers))
    print("done. Run scripts/ticket status.")


if __name__ == "__main__":
    main()
