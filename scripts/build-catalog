#!/usr/bin/env python3
"""Build the normalised, trust-labelled catalogue artifact in data/catalog/ and print dataset statistics."""

import argparse
import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
VENV_PY = ROOT / ".venv/bin/python"
if VENV_PY.exists() and Path(sys.prefix).resolve() != (ROOT / ".venv").resolve():
    os.execv(str(VENV_PY), [str(VENV_PY), *sys.argv])

sys.path.insert(0, str(ROOT / "backend"))

from app.catalog.build import DEFAULT_ARTIFACT_PATH, DEFAULT_RAW_DIR, build_catalog, load_catalog  # noqa: E402


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--raw-dir", type=Path, default=DEFAULT_RAW_DIR)
    parser.add_argument("--output", type=Path, default=DEFAULT_ARTIFACT_PATH)
    parser.add_argument("--validate-schema", action="store_true", help="Validate products.json against product-schema.json")
    args = parser.parse_args()

    t0 = time.perf_counter()
    artifact = build_catalog(
        raw_dir=args.raw_dir,
        output_path=args.output,
        validate_schema=args.validate_schema,
    )
    build_seconds = time.perf_counter() - t0

    t1 = time.perf_counter()
    loaded = load_catalog(args.output)
    load_seconds = time.perf_counter() - t1

    assert len(loaded.products) == len(artifact.products)

    summary = {
        "artifact_path": str(args.output),
        "artifact_bytes": args.output.stat().st_size if args.output.exists() else None,
        "build_seconds": round(build_seconds, 3),
        "load_seconds": round(load_seconds, 3),
        "stats": artifact.stats.model_dump(mode="json"),
    }
    print(json.dumps(summary, indent=2))


if __name__ == "__main__":
    main()
