{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valio-aimo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // The UI (frontend/dist) with SPA fallback. Gateway paths run the Worker first (see src/routes.ts).
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v0.1/*", "/mcp", "/mcp/*", "/health", "/docs", "/docs/*", "/openapi.json"]
  },

  // One FastAPI container. The image is built from the repo root so it can copy backend/ and the
  // architect's gitignored data/catalog + data/fixtures at build time (never committed, patch P7).
  "containers": [
    {
      "class_name": "Gateway",
      "image": "../backend/Dockerfile",
      "image_build_context": "..",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GATEWAY", "class_name": "Gateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gateway"] }],

  // Basic rate limit on the agent channel, per client IP.
  "ratelimits": [
    { "name": "AGENT_RATE_LIMIT", "namespace_id": "4201", "simple": { "limit": 30, "period": 60 } }
  ],

  // Non-secret settings. Secrets (VALIO_API_KEY, OPENROUTER_API_KEY, APPROVAL_SIGNING_KEY) are set
  // with `wrangler secret put` on the architect machine only.
  // MOCK_MODE stays "true" until T08 replaces the legacy app: the legacy lifespan refuses MOCK_MODE=false
  // without an imported SQLite catalogue (architect review of #47). T08 switches to the T02 artifact + T03 provider.
  "vars": {
    "MOCK_MODE": "true",
    "LLM_MODEL": "z-ai/glm-5.3-flash",
    "VALIO_BASE_URL": "https://junction26.valioaimo.fi"
  }
}
