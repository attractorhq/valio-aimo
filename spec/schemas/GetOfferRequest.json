{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:GetOfferRequest",
  "x-contract-version": "0.1",
  "$defs": {
    "OfferItem": {
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "productId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Productid",
          "type": "string"
        },
        "quantity": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "l",
            "kg",
            "pcs",
            "cases"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "productId",
        "quantity",
        "unit"
      ],
      "title": "OfferItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "customerId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Customerid",
      "type": "string"
    },
    "requestedDate": {
      "format": "date",
      "title": "Requesteddate",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/OfferItem"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "lookupDate": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lookupdate"
    }
  },
  "required": [
    "customerId",
    "requestedDate",
    "items"
  ],
  "title": "GetOfferRequest",
  "type": "object"
}
