{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:verified-or-ask:v0.1:TrustLabel",
  "x-contract-version": "0.1",
  "$defs": {
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "K1",
            "K2",
            "K3",
            "K4",
            "K5"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "FactValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/FactValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/FactValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "TrustSource": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "valio-aimo.price-api",
            "valio-aimo.availability-api",
            "valio-aimo.product-data",
            "valio-aimo.substitution-rules",
            "valio-aimo.delivery-reliability",
            "valio-aimo.carbon-footprint",
            "derived",
            "agent"
          ],
          "title": "System",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "retrievedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrievedat"
        }
      },
      "required": [
        "system",
        "field",
        "retrievedAt"
      ],
      "title": "TrustSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fact": {
      "title": "Fact",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/FactValue"
    },
    "display": {
      "title": "Display",
      "type": "string"
    },
    "level": {
      "enum": [
        "VERIFIED",
        "DECLARED",
        "ESTIMATE",
        "UNKNOWN"
      ],
      "title": "Level",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/TrustSource"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    },
    "conflict": {
      "anyOf": [
        {
          "$ref": "#/$defs/Conflict"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "fact",
    "value",
    "display",
    "level",
    "source"
  ],
  "title": "TrustLabel",
  "type": "object"
}
