{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:ReasonOccurrence",
  "x-contract-version": "0.1",
  "$defs": {
    "ReasonCode": {
      "enum": [
        "DATE_LATER",
        "CUTOFF_PASSED",
        "SUPPLIER_STOCK_UNKNOWN",
        "PARTIAL_AVAILABILITY",
        "SPLIT",
        "DATA_CONFLICT",
        "AGENT_SUBSTITUTE",
        "VALIO_SUBSTITUTE",
        "SUBSTITUTE_REJECTED",
        "QUANTITY_BASIS_WEAK",
        "QUANTITY_BASIS_UNKNOWN",
        "LOW_RELIABILITY",
        "UNIT_MISMATCH",
        "OVER_AUTO_LIMIT",
        "OVER_HARD_LIMIT",
        "ALLERGEN_CONTAINS",
        "ALLERGEN_MAY_CONTAIN",
        "ALLERGEN_IMPLICIT",
        "ALLERGEN_UNKNOWN",
        "CLAIM_MISSING",
        "NOT_AVAILABLE",
        "SALES_BLOCKED",
        "PRICE_UNAVAILABLE",
        "INSTRUCTION_IGNORED",
        "NO_CANDIDATE",
        "CLARIFICATION_NEEDED",
        "REQUOTED",
        "DEPOSIT_COST_UNVERIFIED",
        "VARIABLE_WEIGHT_UNVERIFIED",
        "CATEGORY_NOT_ALLOWED",
        "MANDATE_NOT_VALID"
      ],
      "title": "ReasonCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Optional rendered reason for UI/logs; code lists remain the proposal wire shape.",
  "properties": {
    "code": {
      "$ref": "#/$defs/ReasonCode"
    },
    "effect": {
      "enum": [
        "ASK",
        "EXCLUDE",
        "BLOCK",
        "INFO",
        "NO_ORDER"
      ],
      "title": "Effect",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "code",
    "effect",
    "message"
  ],
  "title": "ReasonOccurrence",
  "type": "object"
}
