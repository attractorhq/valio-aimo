{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:CreateProposalRequest",
  "x-contract-version": "0.1",
  "$defs": {
    "NotOrderedItem": {
      "additionalProperties": false,
      "description": "T106: a requested line left out of a multi-line proposal because no compliant product was found.\nIt is never ordered; `reason` is the plain sentence shown to the buyer and the approver.",
      "properties": {
        "itemId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "what": {
          "title": "What",
          "type": "string"
        },
        "quantity": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "l",
            "kg",
            "pcs",
            "cases"
          ],
          "title": "Unit",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "what",
        "quantity",
        "unit",
        "reason"
      ],
      "title": "NotOrderedItem",
      "type": "object"
    },
    "Preference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "BRAND",
            "ORGANIC",
            "ORIGIN",
            "LABEL",
            "FAT_PERCENT",
            "PACK_SIZE",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Preference",
      "type": "object"
    },
    "RequestItem": {
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "quantity": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "l",
            "kg",
            "pcs",
            "cases"
          ],
          "title": "Unit",
          "type": "string"
        },
        "productId": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Productid"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/Preference"
          },
          "title": "Preferences",
          "type": "array"
        },
        "requestedDate": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requesteddate"
        }
      },
      "required": [
        "itemId",
        "what",
        "quantity",
        "unit"
      ],
      "title": "RequestItem",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CLAIM",
            "AVOID_ALLERGEN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "StructuredRequest": {
      "additionalProperties": false,
      "properties": {
        "requestText": {
          "maxLength": 4000,
          "title": "Requesttext",
          "type": "string"
        },
        "requestedDate": {
          "format": "date",
          "title": "Requesteddate",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/RequestItem"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "requestText",
        "requestedDate",
        "items"
      ],
      "title": "StructuredRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "customerId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Customerid",
      "type": "string"
    },
    "offerId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Offerid",
      "type": "string"
    },
    "offerVersion": {
      "minimum": 1,
      "title": "Offerversion",
      "type": "integer"
    },
    "request": {
      "$ref": "#/$defs/StructuredRequest"
    },
    "notOrdered": {
      "items": {
        "$ref": "#/$defs/NotOrderedItem"
      },
      "title": "Notordered",
      "type": "array"
    }
  },
  "required": [
    "customerId",
    "offerId",
    "offerVersion",
    "request"
  ],
  "title": "CreateProposalRequest",
  "type": "object"
}
