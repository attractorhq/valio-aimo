{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:StructuredRequest",
  "x-contract-version": "0.1",
  "$defs": {
    "Preference": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "BRAND",
            "ORGANIC",
            "ORIGIN",
            "LABEL",
            "FAT_PERCENT",
            "PACK_SIZE",
            "OTHER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Preference",
      "type": "object"
    },
    "RequestItem": {
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Itemid",
          "type": "string"
        },
        "what": {
          "minLength": 1,
          "title": "What",
          "type": "string"
        },
        "quantity": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "l",
            "kg",
            "pcs",
            "cases"
          ],
          "title": "Unit",
          "type": "string"
        },
        "productId": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Productid"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/Preference"
          },
          "title": "Preferences",
          "type": "array"
        }
      },
      "required": [
        "itemId",
        "what",
        "quantity",
        "unit"
      ],
      "title": "RequestItem",
      "type": "object"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "CLAIM",
            "AVOID_ALLERGEN"
          ],
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "code"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "requestText": {
      "maxLength": 4000,
      "title": "Requesttext",
      "type": "string"
    },
    "requestedDate": {
      "format": "date",
      "title": "Requesteddate",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RequestItem"
      },
      "minItems": 1,
      "title": "Items",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    }
  },
  "required": [
    "requestText",
    "requestedDate",
    "items"
  ],
  "title": "StructuredRequest",
  "type": "object"
}
