{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:Product",
  "x-contract-version": "0.1",
  "$defs": {
    "AllergenDeclaration": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "CONTAINS",
            "MAY_CONTAIN",
            "FREE_FROM",
            "NOT_LISTED",
            "UNDECLARED",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/TrustLabel"
        }
      },
      "required": [
        "code",
        "status",
        "evidence"
      ],
      "title": "AllergenDeclaration",
      "type": "object"
    },
    "Conflict": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "K1",
            "K2",
            "K3",
            "K4",
            "K5",
            "K6"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "ContentPerSalesUnit": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Value",
          "type": "string"
        },
        "unit": {
          "enum": [
            "l",
            "kg",
            "pcs",
            "cases"
          ],
          "title": "Unit",
          "type": "string"
        },
        "level": {
          "enum": [
            "VERIFIED",
            "DECLARED",
            "ESTIMATE",
            "UNKNOWN"
          ],
          "title": "Level",
          "type": "string"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        }
      },
      "required": [
        "value",
        "unit",
        "level"
      ],
      "title": "ContentPerSalesUnit",
      "type": "object"
    },
    "Deposit": {
      "additionalProperties": false,
      "properties": {
        "productId": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Productid",
          "type": "string"
        },
        "quantity": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Quantity",
          "type": "string"
        },
        "unitPriceExclVat": {
          "anyOf": [
            {
              "pattern": "^\\d+\\.\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unitpriceexclvat"
        }
      },
      "required": [
        "productId",
        "quantity"
      ],
      "title": "Deposit",
      "type": "object"
    },
    "FactValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "items": {
            "$ref": "#/$defs/FactValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/FactValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "TrustLabel": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "title": "Fact",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FactValue"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "level": {
          "enum": [
            "VERIFIED",
            "DECLARED",
            "ESTIMATE",
            "UNKNOWN"
          ],
          "title": "Level",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TrustSource"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "conflict": {
          "anyOf": [
            {
              "$ref": "#/$defs/Conflict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "fact",
        "value",
        "display",
        "level",
        "source"
      ],
      "title": "TrustLabel",
      "type": "object"
    },
    "TrustSource": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "valio-aimo.price-api",
            "valio-aimo.availability-api",
            "valio-aimo.product-data",
            "valio-aimo.substitution-rules",
            "valio-aimo.delivery-reliability",
            "valio-aimo.carbon-footprint",
            "derived",
            "agent"
          ],
          "title": "System",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "retrievedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrievedat"
        }
      },
      "required": [
        "system",
        "field",
        "retrievedAt"
      ],
      "title": "TrustSource",
      "type": "object"
    },
    "UnitConversion": {
      "additionalProperties": false,
      "properties": {
        "unitId": {
          "title": "Unitid",
          "type": "string"
        },
        "sizeInBaseUnits": {
          "pattern": "^\\d+(\\.\\d+)?$",
          "title": "Sizeinbaseunits",
          "type": "string"
        }
      },
      "required": [
        "unitId",
        "sizeInBaseUnits"
      ],
      "title": "UnitConversion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "productId": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Productid",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "names": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Names",
      "type": "object"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "isFood": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Isfood"
    },
    "salesUnit": {
      "title": "Salesunit",
      "type": "string"
    },
    "baseUnit": {
      "title": "Baseunit",
      "type": "string"
    },
    "allowedLotSize": {
      "pattern": "^\\d+(\\.\\d+)?$",
      "title": "Allowedlotsize",
      "type": "string"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitConversion"
      },
      "title": "Units",
      "type": "array"
    },
    "contentPerSalesUnit": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentPerSalesUnit"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "variableWeight": {
      "default": false,
      "title": "Variableweight",
      "type": "boolean"
    },
    "hasAllergenDeclaration": {
      "default": false,
      "title": "Hasallergendeclaration",
      "type": "boolean"
    },
    "allergens": {
      "items": {
        "$ref": "#/$defs/AllergenDeclaration"
      },
      "title": "Allergens",
      "type": "array"
    },
    "claims": {
      "items": {
        "type": "string"
      },
      "title": "Claims",
      "type": "array"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "title": "Labels",
      "type": "array"
    },
    "countryOfOrigin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Countryoforigin"
    },
    "ingredients": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Ingredients",
      "type": "object"
    },
    "substitutions": {
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
      },
      "title": "Substitutions",
      "type": "array"
    },
    "deposits": {
      "items": {
        "$ref": "#/$defs/Deposit"
      },
      "title": "Deposits",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/TrustLabel"
      },
      "title": "Facts",
      "type": "array"
    },
    "gtin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gtin"
    }
  },
  "required": [
    "productId",
    "name",
    "category",
    "salesUnit",
    "baseUnit",
    "allowedLotSize"
  ],
  "title": "Product",
  "type": "object"
}
