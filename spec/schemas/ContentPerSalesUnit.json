{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aimo-connect:v0.1:ContentPerSalesUnit",
  "x-contract-version": "0.1",
  "additionalProperties": false,
  "properties": {
    "value": {
      "pattern": "^\\d+(\\.\\d+)?$",
      "title": "Value",
      "type": "string"
    },
    "unit": {
      "enum": [
        "l",
        "kg",
        "pcs",
        "cases"
      ],
      "title": "Unit",
      "type": "string"
    },
    "level": {
      "enum": [
        "VERIFIED",
        "DECLARED",
        "ESTIMATE",
        "UNKNOWN"
      ],
      "title": "Level",
      "type": "string"
    },
    "method": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Method"
    }
  },
  "required": [
    "value",
    "unit",
    "level"
  ],
  "title": "ContentPerSalesUnit",
  "type": "object"
}
